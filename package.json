{
  "name": "ocr-desktop",
  "version": "0.1.0",
  "description": "OpenCodeReview Desktop — AI 代码审查桌面端",
  "main": "./out/main/index.js",
  "author": "OpenCodeReview Desktop Contributors",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "regen:providers": "node scripts/gen-providers.mjs ../ocr-src/internal/llm/providers.go",
    "package": "npm run build && electron-builder --win --x64 --dir && electron-builder --win nsis --prepackaged release/win-unpacked --config.directories.output=release-installer"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "cross-spawn": "^7.0.6",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "ai.opencodereview.desktop",
    "productName": "OpenCodeReview",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
